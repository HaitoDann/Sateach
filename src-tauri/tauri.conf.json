{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sateach",
  "mainBinaryName": "sateach",
  "version": "0.2.0",
  "identifier": "com.sateach.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": "v1Compatible"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFMEU1OTcxNzcwRkY4REEKUldUYStBOTNjVmtPamxOcnJwUlJoclFMSTl5YldlaVhQakt6Q2ovTm84M0puYVV2NWJqeXN6OTcK",
      "endpoints": [
        "https://github.com/HaitoDann/Sateach-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
